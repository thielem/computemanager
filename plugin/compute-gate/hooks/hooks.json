{
  "description": "deny heavy unwrapped Bash commands; deliver gate notices",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/cgate\" hook 2>/dev/null || true", "timeout": 5 }
        ]
      }
    ]
  }
}
